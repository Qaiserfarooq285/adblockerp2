# Copy to deploy/runpod/.env and fill in.  deploy/runpod/.env is git-ignored:
# the API key never goes into the repository.

# ---- RunPod account -----------------------------------------------------
# runpod.io -> Settings -> API Keys -> "+ Create API Key" (read/write)
RUNPOD_API_KEY=PASTE_YOUR_RUNPOD_API_KEY_HERE

# ---- which pod ----------------------------------------------------------
# The image built from deploy/runpod/Dockerfile and pushed to a registry
# (not needed with `create --bootstrap`).
IMAGE=docker.io/YOUR_DOCKERHUB_USER/betting-ad-blocker-live:1.0
# RunPod container-registry credential id, only for a PRIVATE image
# REGISTRY_AUTH_ID=
# Tried in this order.  Every one has NVENC (hardware H.264 encoder);
# A100 / H100 do NOT, so they are left out on purpose.
GPU_TYPES=NVIDIA GeForce RTX 4090,NVIDIA L40S,NVIDIA RTX A6000,NVIDIA L4
CLOUD_TYPE=SECURE
CONTAINER_DISK_GB=40
# The volume holds the recordings of processed matches (~2.7 GB per match
# hour), the original feed kept for retraining (~1.5 GB/h, capped at 15 GB),
# training frames and model versions.
VOLUME_GB=60
# NETWORK_VOLUME_ID=

# ---- the stream ---------------------------------------------------------
INPUT_URL=https://karostream.tulix.tv/FIFA/index.m3u8
# hls:///workspace/live/out  -> served by the pod at https://<POD_ID>-8080.proxy.runpod.net/out/index.m3u8
# rtmp://ingest.example.com/live/STREAM_KEY  or  srt://host:port?streamid=...  -> pushed to your CDN
OUTPUT_URL=hls:///workspace/live/out
# Makes the pod's URLs unguessable: https://<POD_ID>-8080.proxy.runpod.net/<HTTP_TOKEN>/
HTTP_TOKEN=change-me-to-a-long-random-string

# ---- the model ----------------------------------------------------------
# Private download link for models/ad_seg_best.pt, unless it is baked into the
# image or uploaded to /workspace/models/ on the pod's volume.
AD_WEIGHTS_URL=
USE_TENSORRT=1
# DET_INTERVAL=2
# ENCODER=auto
# VIDEO_BITRATE=6M
# Both on by default: save each processed match, and publish the frame-locked
# ORIGINAL | BETTING ADS HIDDEN view on the pod's page. 0 turns one off.
# RECORD=1
# COMPARE=1

# ---- teaching it new brands (the operator page) ---------------------------
# Password for https://<POD_ID>-8080.proxy.runpod.net/<HTTP_TOKEN>/operator.html
# where operators mark logos to hide and decide new sponsors.  Whoever has it
# decides what is hidden on air: make it long and give it to operators only.
# Empty = no operator page (the viewer page still works).
OPERATOR_TOKEN=
# When to train a new model version from what was collected:
#   idle         once the input has been down for 20 minutes (after a match)
#   daily@04:00  every day at that time (UTC) -- shares the GPU with a live stream
#   off          only from the operator page's "Train a new model now"
AUTO_TRAIN=idle
# SCAN=1              read every board ~1/s: a brand added on the operator page is
#                     hidden at once, before any retraining
# RECORD_ORIGINAL=1   keep the original feed to retrain from (oldest go past 15 GB)

# ---- `create --bootstrap` only: the pod clones this repo at start ---------
# (a PRIVATE repo cannot be cloned by the pod without a token: use the
# Docker-image mode instead, or ask for read-only token support)
REPO_URL=https://github.com/Qaiserfarooq285/adblockerp2.git
REPO_REF=main
